# Sales Trend Analysis
# Forecasting future sales with Prophet
# Visualizing sales trends and seasonal patterns

import pandas as pd
import matplotlib.pyplot as plt
from prophet import Prophet

# ------------ Sample Monthly Sales Dataset ----------------------------
# Simulated sales data for 24 months
data = {
    "Month": pd.date_range(start="2022-01-01", periods=24, freq="MS"),
    "Sales": [12000, 13500, 12500, 14000, 15000, 16000, 17000, 18000,
              17500, 18500, 19000, 20000, 21000, 22000, 21500, 22500,
              23000, 24000, 24500, 25500, 26000, 27000, 27500, 28500]
}
df = pd.DataFrame(data)

# --------------- Visualize Sales Trends ----------------------------
plt.figure(figsize=(12,6))
plt.plot(df["Month"], df["Sales"], marker="o", linestyle="-", color="blue")
plt.title("Monthly Sales Trend")
plt.xlabel("Month")
plt.ylabel("Sales ($)")
plt.grid(True)
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()

# ------------------ Forecast Future Sales using Prophet  ----------------------------
# Prophet requires columns: ds (date), y (value)
df_prophet = df.rename(columns={"Month": "ds", "Sales": "y"})

# Initialize and fit Prophet model
model = Prophet(yearly_seasonality=True, weekly_seasonality=False, daily_seasonality=False)
model.fit(df_prophet)

# Create future dataframe for next 12 months
future = model.make_future_dataframe(periods=12, freq='MS')
forecast = model.predict(future)

# ------------------- Visualize Forecast  ----------------------------
fig1 = model.plot(forecast)
plt.title("Sales Forecast for Next 12 Months")
plt.xlabel("Month")
plt.ylabel("Sales ($)")
plt.show()


# ----------------- Components (trend + seasonality)  ----------------------------
fig2 = model.plot_components(forecast)
plt.show()
